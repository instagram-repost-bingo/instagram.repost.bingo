# Copy this file to .env.local for local development.
# On Vercel, set the same names in Project Settings > Environment Variables.

# Required. Connection string for the cluster the bot uses (Atlas: Connect > Drivers > Node.js).
# The database is the name after ".mongodb.net/"; without one the site uses "repost_bingo".
# The bot must use the same database.
MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/repost_bingo?retryWrites=true&w=majority"

# Required in production: Cloudflare Turnstile keys (Cloudflare dashboard > Turnstile).
# Without a secret key, production refuses entries; local `bun run dev` skips the check.
# The site key is built into the page, so redeploy after changing it.
# Cloudflare's test keys (always pass) for local testing:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
